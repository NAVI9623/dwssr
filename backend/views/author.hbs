<div class="author-container">
  <h1>{{title}}</h1>
  
  <div class="author-card">

     <div class="author-photo">
      <img src="{{profileimage}}" alt="Foto de {{author}}" />
    </div>
    <h2>{{author}}</h2>
    <p><strong>Descripción:</strong> {{description}}</p>
  </div>

  <div class="back-link">
    <a href="/">← Volver al inicio</a>
  </div>
</div>

