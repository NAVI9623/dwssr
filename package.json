{
  "name": "dwssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./server/bin/www",
    "dev:back": "nodemon ./server/bin/www",
    "dev:front": "vite",
    "dev:all": "npm run dev:back & npm run dev:front",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:back && npm run lint:front",
    "lint:back": "eslint \"server/**/*.js\"",
    "lint:front": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint . --fix",
    "clean:logs": "rm -rf ./server/logs/*.log"
  },
  "imports": {
    "#routes/*": "./server/routes/*.js",
    "#views/*": "./server/views/*.js",
    "#models/*": "./server/models/*.js"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "hbs": "^4.2.0",
    "http-errors": "~1.6.3",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "daisyui": "^5.5.19",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.2"
  }
}
